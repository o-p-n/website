<!DOCTYPE html>
<html>
  <head>
    <title>{{if title }}{{title}} :: {{ /if }}{{ site.title }}</title>
    <meta charset="utf-8"/>
    <meta itemprop="created" content="{{ date |> utcdate }}"/>
    <link rel="stylesheet" href="/styles/main.css" />
    <style>{{ style }}</style>
  </head>
  <body>
    {{ content }}

    {{ if footnotes.length }}
    <section class="footnotes">
      <hr class="footnote-sep" />
      <ul>
        {{ for note of footnotes }}
        <li class="footnote-item" id={{ note.id }}>
          <span class="footnote-label"><a href=#{{ note.refId }}>[{{ note.label }}</a>]:</span>
          {{ note.content }}
        </li>
        {{ /for }}
      </ul>
    </section>
    {{ /if }}
  </body>
</html>